# Port the bot server listens on
PORT=3001

# Shared bearer token. The Lovable dashboard sends this in the
# Authorization: Bearer <token> header on every request.
# Generate something random and keep it secret.
BOT_API_TOKEN=change-me-to-a-long-random-string

# (Optional) Lovable Cloud webhook URL where inbound WhatsApp messages
# are forwarded. You can also set this from the dashboard at runtime
# via POST /webhook-config.
# Example:
# WEBHOOK_URL=https://YOUR-PROJECT.supabase.co/functions/v1/wa-webhook
WEBHOOK_URL=

# (Optional) Secret expected by the webhook to authenticate the bot.
# Must match bot_settings.webhook_secret for the user.
WEBHOOK_SECRET=

# CORS allow-list (comma separated). Use * for any origin during dev.
CORS_ORIGIN=*
